        "concurrency": 1,
        "parameters": {
          "entities": {
            "type": "Array"
          }
        },
        "description": "Sequential metadata-driven batch; every item enters the serialized entity pipeline.",
        "activities": [
          {
            "name": "ForEachEntity",
            "type": "ForEach",
            "typeProperties": {
              "items": {
                "value": "@pipeline().parameters.entities",
                "type": "Expression"
              },
              "isSequential": true,
              "activities": [
                {
                  "name": "ExtractEntity",
                  "type": "ExecutePipeline",
                  "typeProperties": {
                    "pipeline": {
                      "referenceName": "pl-fo-extract-entity",
                      "type": "PipelineReference"
                    },
                    "waitOnCompletion": true,
                    "parameters": {
                      "entity": {
                        "value": "@item().entity",
                        "type": "Expression"
                      },
                      "legalEntity": {
                        "value": "@item().legalEntity",
                        "type": "Expression"
                      },
                      "loadMode": {
                        "value": "@item().loadMode",
                        "type": "Expression"
                      },
                      "watermarkField": {
                        "value": "@coalesce(item()?.watermarkField, 'ModifiedDateTime')",
                        "type": "Expression"
                      }
                    }
                  }
                }
              ]
            }
          }
        ]
      }
