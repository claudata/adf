    {
      "type": "Microsoft.DataFactory/factories/pipelines",
      "apiVersion": "2018-06-01",
      "name": "[concat(parameters('factoryName'), '/pl-fo-discover-legal-entities')]",
      "dependsOn": [
        "[resourceId('Microsoft.DataFactory/factories/datasets', parameters('factoryName'), 'ds_fo_rest')]",
        "[resourceId('Microsoft.DataFactory/factories/datasets', parameters('factoryName'), 'ds_fo_raw_json')]"
      ],
      "properties": {
        "description": "Lists legal entities (cross-company) to validate authorization; fails on an empty result.",
        "activities": [
          {
            "name": "CopyLegalEntities",
            "type": "Copy",
            "policy": {
              "timeout": "0.00:30:00",
              "retry": "[parameters('copyRetries')]",
              "retryIntervalInSeconds": "[parameters('retryIntervalSeconds')]",
              "secureInput": true,
              "secureOutput": false
            },
            "typeProperties": {
              "source": {
                "type": "RestSource",
                "requestMethod": "GET",
                "httpRequestTimeout": "00:02:00",
                "paginationRules": {
                  "AbsoluteUrl": "$['@odata.nextLink']",
                  "supportRFC5988": "false"
                }
              },
              "sink": {
                "type": "JsonSink",
                "storeSettings": {
                  "type": "AzureBlobFSWriteSettings"
                },
                "formatSettings": {
                  "type": "JsonWriteSettings",
                  "filePattern": "arrayOfObjects"
                }
              }
            },
            "inputs": [
              {
                "referenceName": "ds_fo_rest",
                "type": "DatasetReference",
                "parameters": {
                  "relativeUrl": {
                    "value": "data/LegalEntities?$select=LegalEntityId,Name&cross-company=true",
                    "type": "Expression"
                  }
                }
              }
            ],
            "outputs": [
              {
                "referenceName": "ds_fo_raw_json",
                "type": "DatasetReference",
                "parameters": {
                  "folderPath": {
                    "value": "@concat('dynamics-fo/rest/legal-entity-discovery/', pipeline().RunId)",
                    "type": "Expression"
                  },
                  "fileName": "response-pages.json"
                }
              }
            ]
          },
          {
            "name": "RequireLegalEntity",
            "type": "IfCondition",
            "dependsOn": [
              {
                "activity": "CopyLegalEntities",
                "dependencyConditions": [
                  "Succeeded"
                ]
              }
            ],
            "typeProperties": {
              "expression": {
                "value": "@equals(activity('CopyLegalEntities').output.rowsCopied, 0)",
                "type": "Expression"
              },
              "ifTrueActivities": [
                {
                  "name": "FailRequireLegalEntity",
                  "type": "Fail",
                  "typeProperties": {
                    "errorCode": "NoLegalEntities",
                    "message": "The application returned no legal entities; check the F&O user mapping and security role."
                  }
                }
              ],
              "ifFalseActivities": []
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.DataFactory/factories/pipelines",
      "apiVersion": "2018-06-01",
      "name": "[concat(parameters('factoryName'), '/pl-fo-validate-raw-json')]",
      "dependsOn": [
        "[resourceId('Microsoft.DataFactory/factories/datasets', parameters('factoryName'), 'ds_fo_raw_json')]"
      ],
      "properties": {
        "description": "Reads a small raw JSON file through the private runtime (Lookup limit 5000 rows / 4 MB).",
        "parameters": {
          "folderPath": {
            "type": "String"
          },
          "fileName": {
            "type": "String",
            "defaultValue": "response-pages.json"
          }
        },
        "activities": [
          {
            "name": "InspectFile",
            "type": "GetMetadata",
            "policy": {
              "timeout": "0.00:10:00",
              "retry": 2,
              "retryIntervalInSeconds": 30
            },
            "typeProperties": {
              "dataset": {
                "referenceName": "ds_fo_raw_json",
                "type": "DatasetReference",
                "parameters": {
                  "folderPath": {
                    "value": "@pipeline().parameters.folderPath",
                    "type": "Expression"
                  },
                  "fileName": {
                    "value": "@pipeline().parameters.fileName",
                    "type": "Expression"
                  }
                }
              },
              "fieldList": [
                "exists",
                "size",
                "lastModified"
              ],
              "storeSettings": {
                "type": "AzureBlobFSReadSettings",
                "recursive": false
              }
            }
          },
          {
            "name": "ReadRawFile",
            "type": "Lookup",
            "dependsOn": [
              {
                "activity": "InspectFile",
                "dependencyConditions": [
                  "Succeeded"
                ]
              }
            ],
            "policy": {
              "timeout": "0.00:10:00",
              "retry": 2,
              "retryIntervalInSeconds": 30
            },
            "typeProperties": {
              "source": {
                "type": "JsonSource",
                "storeSettings": {
                  "type": "AzureBlobFSReadSettings",
                  "recursive": false
                },
                "formatSettings": {
                  "type": "JsonReadSettings"
                }
              },
              "dataset": {
                "referenceName": "ds_fo_raw_json",
                "type": "DatasetReference",
                "parameters": {
                  "folderPath": {
                    "value": "@pipeline().parameters.folderPath",
                    "type": "Expression"
                  },
                  "fileName": {
                    "value": "@pipeline().parameters.fileName",
                    "type": "Expression"
                  }
                }
              },
              "firstRowOnly": false
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.DataFactory/factories/pipelines",
      "apiVersion": "2018-06-01",
      "name": "[concat(parameters('factoryName'), '/pl-fo-read-checkpoint')]",
      "dependsOn": [
        "[resourceId('Microsoft.DataFactory/factories/datasets', parameters('factoryName'), 'ds_fo_checkpoints')]"
      ],
      "properties": {
        "description": "Read-only checkpoint inspection using the same derived key and connector-isolated partition.",
        "parameters": {
          "entity": {
            "type": "String",
            "defaultValue": "CustomersV3"
          },
          "legalEntity": {
            "type": "String",
            "defaultValue": "ALL"
          }
        },
        "variables": {
          "checkpointKey": {
            "type": "String"
          },
          "partitionKey": {
            "type": "String",
            "defaultValue": "[concat(parameters('tenantId'), '|', parameters('environmentName'), '|rest')]"
          }
        },
        "activities": [
          {
            "name": "SetCheckpointKey",
            "type": "SetVariable",
            "dependsOn": [],
            "typeProperties": {
              "variableName": "checkpointKey",
              "value": {
                "value": "@replace(replace(replace(base64(string(createArray(pipeline().parameters.legalEntity, pipeline().parameters.entity))), '/', '_'), '+', '-'), '=', '')",
                "type": "Expression"
              }
            }
          },
          {
            "name": "ReadCheckpoint",
            "type": "Lookup",
            "dependsOn": [
              {
                "activity": "SetCheckpointKey",
                "dependencyConditions": [
                  "Succeeded"
                ]
              }
            ],
            "policy": {
              "timeout": "0.00:30:00",
              "retry": "[parameters('copyRetries')]",
              "retryIntervalInSeconds": "[parameters('retryIntervalSeconds')]",
              "secureInput": true,
              "secureOutput": false
            },
            "typeProperties": {
              "source": {
                "type": "AzureTableSource",
                "azureTableSourceQuery": {
                  "value": "@concat('PartitionKey eq ''', variables('partitionKey'), ''' and RowKey eq ''', variables('checkpointKey'), '''')",
                  "type": "Expression"
                },
                "azureTableSourceIgnoreTableNotFound": false
              },
              "dataset": {
                "referenceName": "ds_fo_checkpoints",
                "type": "DatasetReference"
              },
              "firstRowOnly": false
            }
          }
        ]
      }
    }
  ]
